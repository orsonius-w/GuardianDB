---
import Head from "./head.astro";
import Header from "../components/header/header.astro";
import Footer from "../components/footer/footer.astro";

import "../styles/style.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "Guardian DB",
  description = "Guardian, a tactical-grid collectible card game: card gallery, rules wiki and the digital client.",
  image = "/images/og-default.jpg",
  url = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props as Props;
const absImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <Head {title} {description} image={absImage} {url} />
  <body>
    <div class="page-layout">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
