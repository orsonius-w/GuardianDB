---
// Wiki page frame: sidebar navigation + article. Used by every /wiki page.
import Layout from "./layout.astro";
import Pagesection from "../components/sections/pagesection.astro";
import { wikiNav } from "../lib/wiki";
import "../styles/wiki-style.css";

interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
const nav = await wikiNav();
const here = Astro.url.pathname.replace(/\/?$/, "/");
---

<Layout title={`${title} | Guardian Wiki`} description={description}>
  <Pagesection size="base">
    <div class="wiki">
      <aside class="wiki-nav">
        <details open>
          <summary>Wiki contents</summary>
          <nav aria-label="Wiki">
            <a href="/wiki/" class="wiki-home" aria-current={here === "/wiki/" ? "page" : undefined}>Wiki home</a>
            {nav.map(([section, items]) => (
              <div class="wiki-group">
                <h2>{section}</h2>
                <ul>
                  {items.map((i) => (
                    <li><a href={i.href} aria-current={here === i.href || (i.href !== "/wiki/" && here.startsWith(i.href) && i.href.includes("keywords")) ? "page" : undefined}>{i.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </details>
      </aside>
      <article class="wiki-article">
        <slot name="before" />
        <h1>{title}</h1>
        {description && <p class="lede">{description}</p>}
        <div class="prose"><slot /></div>
      </article>
    </div>
  </Pagesection>
</Layout>
