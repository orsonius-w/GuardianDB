---
// Wiki page frame: sidebar navigation + article. Used by every /wiki page.
import Layout from "./layout.astro";
import Pagesection from "../components/sections/pagesection.astro";
import { wikiNav } from "../lib/wiki";
import "../styles/wiki-style.css";

interface Props {
  title: string;
  description?: string;
  // Optional custom sidebar (the lore section uses its own). Defaults to the wiki's.
  nav?: [string, { title: string; href: string }[]][];
  home?: { title: string; href: string };
  titleSuffix?: string;
}
const { title, description, home = { title: "Wiki home", href: "/wiki/" }, titleSuffix = "Guardian Wiki" } = Astro.props;
const nav = Astro.props.nav ?? (await wikiNav());
const here = Astro.url.pathname.replace(/\/?$/, "/");
---

<Layout title={`${title} | ${titleSuffix}`} description={description}>
  <Pagesection size="base">
    <div class="wiki">
      <aside class="wiki-nav">
        <details open>
          <summary>Contents</summary>
          <nav aria-label="Wiki">
            <a href={home.href} class="wiki-home" aria-current={here === home.href ? "page" : undefined}>{home.title}</a>
            {nav.map(([section, items]) => (
              <div class="wiki-group">
                <h2>{section}</h2>
                <ul>
                  {items.map((i) => (
                    <li><a href={i.href} aria-current={here === i.href || (i.href !== "/wiki/" && here.startsWith(i.href) && i.href.includes("keywords")) ? "page" : undefined}>{i.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </details>
      </aside>
      <article class="wiki-article">
        <slot name="before" />
        <h1>{title}</h1>
        {description && <p class="lede">{description}</p>}
        <div class="prose"><slot /></div>
      </article>
    </div>
  </Pagesection>
</Layout>
