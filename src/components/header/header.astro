---
import Nav from "../nav.astro";
---

<header>
  <div class="base-layout">
    <div class="header">
      <div class="col">
        <div class="branding">
          <a href="/">
            <img src="/images/brand/logo.webp" alt="Guardian" width="900" height="180" />
          </a>
        </div>
      </div>
      <div class="col">
        <Nav />
      </div>
    </div>
  </div>
</header>

<style>
  header {
    padding-block: 2rem;
  }

  .header {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
  }

  .branding img {
    width: auto;
    height: 38px;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.6));
  }
</style>
