---
import { navData } from "../data/navData";
import { SITE_LINKS } from "../data/site";

import { Icon } from "astro-icon/components";
---

<script>
  const navToggle = document.querySelector('[aria-controls="primary-nav"]');

  navToggle?.addEventListener("click", () => {
    const navOpened = navToggle.getAttribute("aria-expanded");
    if (navOpened === "false") {
      navToggle.setAttribute("aria-expanded", "true");
    } else {
      navToggle.setAttribute("aria-expanded", "false");
    }
  });
</script>

<button aria-controls="primary-nav" aria-expanded="false">
  <span class="visually-hidden"> Menu </span>
  <Icon name="ci:hamburger" size="64" class="icon-hamburger" />
  <Icon name="ci:close-md" size="64" class="icon-close" />
</button>

<nav id="primary-nav">
  <ul>
    {
      navData.map((item) => (
        <li>
          <a href={item.path} aria-current={item.match.some((m) => Astro.url.pathname.startsWith(m)) ? "page" : undefined}>{item.name}</a>
        </li>
      ))
    }
    {SITE_LINKS.discord && (
      <li>
        <a href={SITE_LINKS.discord} target="_blank" rel="noopener" class="nav-discord">
          <Icon name="ci:chat-conversation" size="20" aria-hidden="true" />
          <span>Discord</span>
        </a>
      </li>
    )}
  </ul>
</nav>

<style>
  nav ul {
    display: flex;
    gap: clamp(0.25rem, 2vw, 1rem);
    align-items: center;
    list-style: none;

    li a {
      color: var(--clr-white);
      text-decoration: none;
      font-family: var(--ff-secondary);
      padding: 0.5rem;
      border-radius: var(--radius-base);
      transition: 0.2s;
      font-size: var(--fs-md);

      &[aria-current="page"] {
        background-color: hsl(0 0 100 / 0.12);
      }

      &:not(:has(svg)):hover,
      &:not(:has(svg)):focus-visible {
        background-color: hsl(0 0 100 / 0.2);
      }
      &:has(svg):hover,
      &:has(svg):focus-visible {
        opacity: 0.8;
      }
    }
  }

  nav ul li a.nav-discord {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid hsl(255 45% 82% / 0.5);
    padding-inline: 0.8rem;
  }
  nav ul li a.nav-discord:hover,
  nav ul li a.nav-discord:focus-visible {
    background-color: hsl(255 45% 82% / 0.15);
    opacity: 1;
  }

  button {
    display: none;
  }

  @media (width < 768px) {
    button {
      display: block;
      position: absolute;
      z-index: 10;
      right: 1rem;
      padding: 1rem;
      background: transparent;
      border: 0;
      color: white;

      .icon-close {
        display: none;
      }
    }
    nav {
      display: none;
    }

    [aria-expanded="true"] {
      .icon-hamburger {
        display: none;
      }
      .icon-close {
        display: block;
      }
    }

    [aria-expanded="true"] + nav {
      display: block;
      position: absolute;
      inset: 0;
      width: 70%;
      margin-left: auto;
      top: 0;
      right: 0;
      background-color: var(--clr-neutral-900);
      box-shadow: 0 0 0 100vmax hsl(0 0 0 / 0.3);
      z-index: 5;

      ul {
        margin-top: 20vh;
        margin-left: 3rem;
        display: grid;
        gap: 2rem;
      }

      a {
        color: var(--clr-neutral-100);

        &:hover,
        &:focus-visible {
          color: var(--clr-primary);
        }
      }
    }
  }
</style>
