---
// Faint drifting embers / Aether motes over the hero. Off for "reduce motion".
---
<canvas class="embers" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("canvas.embers");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (canvas && !reduce) {
    const ctx = canvas.getContext("2d")!;
    let w = 0, h = 0, dpr = Math.min(devicePixelRatio || 1, 2);
    type P = { x: number; y: number; r: number; vy: number; vx: number; a: number; hue: number; t: number };
    let ps: P[] = [];
    const resize = () => {
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(70, (w * h) / 22000));
      ps = Array.from({ length: n }, () => spawn(true));
    };
    const spawn = (anywhere = false): P => ({
      x: Math.random() * w, y: anywhere ? Math.random() * h : h + 10,
      r: 0.6 + Math.random() * 1.8, vy: 0.15 + Math.random() * 0.45, vx: (Math.random() - 0.5) * 0.25,
      a: 0.15 + Math.random() * 0.5, hue: Math.random() < 0.7 ? 38 : 195, t: Math.random() * 100,
    });
    let running = true;
    new IntersectionObserver(([e]) => { running = e.isIntersecting; if (running) requestAnimationFrame(tick); }).observe(canvas);
    function tick() {
      if (!running) return;
      ctx.clearRect(0, 0, w, h);
      for (const p of ps) {
        p.t += 0.01; p.y -= p.vy; p.x += p.vx + Math.sin(p.t) * 0.15;
        if (p.y < -10) Object.assign(p, spawn());
        const g = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
        g.addColorStop(0, `hsla(${p.hue}, 100%, 70%, ${p.a})`);
        g.addColorStop(1, `hsla(${p.hue}, 100%, 60%, 0)`);
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(p.x, p.y, p.r * 4, 0, Math.PI * 2); ctx.fill();
      }
      requestAnimationFrame(tick);
    }
    addEventListener("resize", resize);
    resize(); tick();
  }
</script>

<style>
  .embers { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; mix-blend-mode: screen; }
</style>
