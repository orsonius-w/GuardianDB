---
import { SITE_LINKS } from "../../data/site";
const year = new Date().getFullYear();
const cols = [
  { title: "Learn", links: [["Learn to play", "/learn/"], ["Rules wiki", "/wiki/"], ["Keywords", "/wiki/keywords/"]] },
  { title: "Cards", links: [["Gallery", "/gallery/"], ["Starter decks", "/decks/"], ["Ailments & hazards", "/wiki/status-ailments/"]] },
  { title: "Guardian", links: [["Lore", "/lore/"], ["Play the alpha", "/play/"], ["News", "/news/"]] },
];
const community = [
  SITE_LINKS.itch && { name: "itch.io", href: SITE_LINKS.itch },
  SITE_LINKS.discord && { name: "Discord", href: SITE_LINKS.discord },
].filter(Boolean) as { name: string; href: string }[];
---

<footer>
  <div class="base-layout">
    <div class="footer-grid">
      <div class="brand">
        <a href="/"><img src="/images/brand/logo.webp" alt="Guardian" width="900" height="180" /></a>
        <p>A tactical-grid collectible card game, in development since 2010.</p>
        {community.length > 0 && (
          <p class="community">{community.map((c) => <a href={c.href} target="_blank" rel="noopener" class="pill">{c.name}</a>)}</p>
        )}
      </div>
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>{c.links.map(([t, h]) => <li><a href={h}>{t}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="copyright">Guardian CG &copy; 2010–{year}</p>
  </div>
</footer>

<style>
  footer { margin-block-start: 3rem; padding-block: 2.5rem 1.5rem; border-top: 1px solid hsl(0 0 100 / 0.1); background: hsl(0 0 0 / 0.2); font-size: var(--fs-sm); }
  .footer-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2rem; }
  @media (width < 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  .brand img { height: 36px; width: auto; margin-block-end: 0.75rem; }
  .brand p { color: var(--clr-neutral-300); max-width: 22rem; }
  .community { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pill { padding: 0.3rem 0.9rem; border: 1px solid hsl(0 0 100 / 0.3); border-radius: var(--radius-full); color: white; text-decoration: none; }
  .pill:hover { border-color: var(--clr-primary); color: white; }
  h2 { font-size: var(--fs-sm); text-transform: uppercase; letter-spacing: 1px; color: var(--clr-neutral-400); margin-block: 0 0.75rem; font-family: var(--ff-base); }
  ul { list-style: none; padding: 0; display: grid; gap: 0.35rem; }
  li { line-height: 1.4; }
  nav a { color: var(--clr-neutral-100); text-decoration: none; }
  nav a:hover { color: var(--clr-primary); }
  .copyright { text-align: center; color: var(--clr-neutral-400); margin: 2rem 0 0; }
</style>
