---
// An example Stack: three items, resolving top-down (last in, first out).
const items = [
  { who: "You", what: "A Quick Spell in response", note: "added last, resolves first" },
  { who: "Opponent", what: "A Quick Spell: the defender gets +2 Defense", note: "" },
  { who: "You", what: "Your Summon declares an attack", note: "added first, resolves last" },
];
---
<figure class="stack">
  <ol>
    {items.map((i, n) => (
      <li class:list={{ you: i.who === "You" }}>
        <span class="who">{i.who}</span>
        <span class="what">{i.what}</span>
        {i.note && <small>{i.note}</small>}
      </li>
    ))}
  </ol>
  <figcaption><span class="arrow">↓</span> resolves from the top</figcaption>
</figure>

<style>
  .stack { margin: 1.5rem 0; display: grid; grid-template-columns: minmax(0, 26rem) auto; gap: 1rem; align-items: center; }
  ol { list-style: none; padding: 0 !important; margin: 0 !important; display: grid; gap: 4px; }
  li {
    margin: 0 !important; display: grid; grid-template-columns: 5.5rem 1fr; gap: 0 0.75rem; padding: 0.6rem 0.9rem;
    border-radius: var(--radius-base); background: hsl(3 35% 28%); border-left: 4px solid hsl(3 60% 55%);
  }
  li.you { background: hsl(200 40% 25%); border-left-color: var(--clr-primary); }
  .who { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 1px; color: var(--clr-neutral-200); align-self: center; }
  small { grid-column: 2; color: var(--clr-neutral-300); font-size: var(--fs-xs); }
  figcaption { color: var(--clr-neutral-300); font-size: var(--fs-sm); }
  .arrow { font-size: 1.5rem; color: var(--clr-accent); }
</style>
