---
// A small grid showing which fields a combat type can reach from the centre.
// Distance counts like movement: orthogonal neighbour = 1, diagonal neighbour = 2.
interface Props { min: number; max: number; label: string; caption?: string; size?: number; icon?: string; }
const { min, max, label, caption, size = 7, icon } = Astro.props;
const c = Math.floor(size / 2);
const cells = Array.from({ length: size * size }, (_, i) => {
  const x = i % size, y = Math.floor(i / size);
  const d = Math.abs(x - c) + Math.abs(y - c);
  return { me: d === 0, hit: d >= min && d <= max };
});
---
<figure class="range">
  <div class="g" style={`--n:${size}`} role="img" aria-label={`${label}: ${caption ?? ""}`}>
    {cells.map((cell) => <span class:list={{ hit: cell.hit, me: cell.me }} />)}
  </div>
  <figcaption>
    {icon && <img src={icon} alt="" width="32" height="32" />}
    <strong>{label}</strong>
    {caption && <small>{caption}</small>}
  </figcaption>
</figure>

<style>
  .range { margin: 0; display: grid; gap: 0.5rem; justify-items: center; text-align: center; }
  .g { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 3px; width: min(100%, 11rem); }
  .g span { aspect-ratio: 1; border-radius: 3px; background: hsl(0 0 100 / 0.07); }
  .g span.hit { background: hsl(40 70% 52%); }
  .g span.me { background: var(--clr-primary); box-shadow: inset 0 0 0 3px hsl(200 95% 25%); }
  figcaption { display: grid; justify-items: center; gap: 0.15rem; line-height: 1.3; max-width: 100%; }
  figcaption img { width: 32px; height: auto; }
  figcaption small { color: var(--clr-neutral-300); font-size: var(--fs-sm); }
</style>
