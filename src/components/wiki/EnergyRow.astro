---
// The ten kinds of Energy with the game's element symbols.
const kinds = ["Neutral", "Light", "Darkness", "Fire", "Water", "Earth", "Wind", "Lightning", "Ice", "Nature"];
---
<ul class="energy">
  {kinds.map((k) => (
    <li><img src={`/images/elements/${k.toLowerCase()}.webp`} alt="" width="48" height="48" /><span>{k}</span></li>
  ))}
</ul>

<style>
  .energy { list-style: none; padding: 0 !important; display: flex; flex-wrap: wrap; gap: 0.75rem 1.1rem; margin-block: 1.25rem !important; }
  .energy li { display: grid; justify-items: center; gap: 0.25rem; margin: 0 !important; font-size: var(--fs-sm); color: var(--clr-neutral-200); }
  .energy img { width: 2.6rem; height: 2.6rem; }
</style>
