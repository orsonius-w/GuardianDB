---
// One or two example cards on the left, explanation (the slot) on the right.
// <CardSide cards={[{ slug: "agile-serval", caption: "A Summon with no rules text" }]}> ...markdown... </CardSide>
import { cards } from "../../lib/cards";
interface Props { cards: { slug: string; caption?: string }[]; }
const list = Astro.props.cards.map((c) => ({ ...c, card: cards.find((x) => x.slug === c.slug) })).filter((c) => c.card);
const landscape = list.some((c) => (c.card!.imageWidth ?? 0) > (c.card!.imageHeight ?? 0));
---
<div class:list={["card-side", { two: list.length > 1, landscape }]}>
  <div class="cs-cards">
    {list.map(({ card, caption }) => (
      <figure>
        <a href={`/cards/${card!.slug}/`}><img src={card!.image ?? ""} alt={card!.name} width={card!.imageWidth} height={card!.imageHeight} loading="lazy" decoding="async" /></a>
        <figcaption><strong>{card!.name}</strong>{caption && <small>{caption}</small>}</figcaption>
      </figure>
    ))}
  </div>
  <div class="cs-text"><slot /></div>
</div>

<style>
  .card-side { display: grid; grid-template-columns: minmax(9rem, 13rem) 1fr; gap: 1.5rem; align-items: start; margin-block: 1rem 2rem; }
  .card-side.two { grid-template-columns: minmax(16rem, 22rem) 1fr; }
  .card-side.landscape { grid-template-columns: minmax(14rem, 20rem) 1fr; }
  @media (width < 640px) { .card-side, .card-side.two, .card-side.landscape { grid-template-columns: 1fr; } .cs-cards { max-width: 22rem; } }
  .cs-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: 0.75rem; }
  figure { margin: 0; display: grid; gap: 0.4rem; text-align: center; }
  img { width: 100%; height: auto; border-radius: 8px; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5); transition: transform 0.15s; }
  a:hover img { transform: translateY(-3px); }
  figcaption { display: grid; gap: 0.1rem; line-height: 1.3; font-size: var(--fs-sm); }
  small { color: var(--clr-neutral-300); }
  .cs-text :global(p:first-child) { margin-block-start: 0; }
</style>
