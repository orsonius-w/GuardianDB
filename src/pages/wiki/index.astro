---
import WikiLayout from "../../layout/wikilayout.astro";
import { wikiNav } from "../../lib/wiki";
const nav = await wikiNav();
---

<WikiLayout title="Guardian Wiki" description="Everything you need to learn and play Guardian.">
  <p>New to Guardian? Start with the <a href="/wiki/intro/">Introduction</a>, then read <a href="/wiki/turn-structure/">Turn Structure</a> and <a href="/wiki/combat/">Combat</a>. That's enough to play your first game.</p>
  <div class="wiki-index">
    {nav.map(([section, items]) => (
      <section class="wiki-index-group">
        <h2>{section}</h2>
        <ul>{items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}</ul>
      </section>
    ))}
  </div>
</WikiLayout>
