---
import { getCollection, render } from "astro:content";
import WikiLayout from "../../layout/wikilayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("wiki");
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
const { Content } = await render(page);
---

<WikiLayout title={page.data.title} description={page.data.description}>
  <Content />
</WikiLayout>
