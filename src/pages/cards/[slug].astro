---
import Layout from "../../layout/layout.astro";
import Pagesection from "../../components/sections/pagesection.astro";
import CardDetail from "../../components/cards/CardDetail.astro";
import { cards, ELEMENTS, type Card } from "../../lib/cards";

export function getStaticPaths() {
  return cards.map((card, i) => ({ params: { slug: card.slug }, props: { card } }));
}

const { card } = Astro.props as { card: Card };
const element = ELEMENTS.find((e) => e.name === card.elements[0]) ?? ELEMENTS[ELEMENTS.length - 1];

// Previous / next card within the same element, alphabetical, tokens skipped.
const siblings = cards.filter((c) => c.elements[0] === card.elements[0] && !c.token);
const pos = siblings.findIndex((c) => c.id === card.id);
const prev = pos > 0 ? siblings[pos - 1] : null;
const next = pos >= 0 && pos < siblings.length - 1 ? siblings[pos + 1] : null;

const description = `${card.typeLine} — ${card.text.replace(/\s+/g, " ").slice(0, 150)}`;
---

<Layout
  title={`${card.name} | Guardian`}
  description={description}
  image={card.image ?? undefined}
  url={`https://guardiancg.netlify.app/cards/${card.slug}/`}
>
  <Pagesection size="md">
    <p class="crumbs">
      <a href="/gallery/">Gallery</a> / <a href={`/gallery/${element.slug}/`}>{element.name}</a> / {card.name}
    </p>

    <CardDetail card={card}>
      <nav class="prev-next" aria-label="Browse cards">
        {prev ? <a href={`/cards/${prev.slug}/`} rel="prev">← {prev.name}</a> : <span />}
        {next ? <a href={`/cards/${next.slug}/`} rel="next">{next.name} →</a> : <span />}
      </nav>
    </CardDetail>
  </Pagesection>
</Layout>

<style>
  .crumbs { color: var(--clr-neutral-300); margin-block-end: 1.5rem; }
  .prev-next {
    display: flex; justify-content: space-between; gap: 1rem;
    margin-block-start: 2rem; padding-block-start: 1rem;
    border-top: 1px solid hsl(0 0 100 / 0.15);
  }
</style>
