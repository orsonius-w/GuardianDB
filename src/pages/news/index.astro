---
import Pagesection from "../../components/sections/pagesection.astro";
import Layout from "../../layout/layout.astro";
import { newsPosts, formatDate } from "../../lib/news";
const posts = await newsPosts();
---

<Layout title="News | Guardian" description="News, updates and patch notes for Guardian.">
  <Pagesection size="md">
    <h1>News</h1>
    <div class="news-list">
      {posts.map((post) => (
        <a href={`/news/${post.id}/`} class="news-post">
          <p class="news-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {post.data.category}</p>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </Pagesection>
</Layout>

<style>
  .news-list { display: grid; gap: 1rem; max-width: 60rem; }
  .news-post {
    display: block; padding: 1.25rem 1.5rem; color: inherit; text-decoration: none;
    border: 1px solid hsl(0 0 100 / 0.12); border-radius: var(--radius-md);
    transition: border-color 0.15s, background-color 0.15s;
    &:hover { border-color: var(--clr-primary); background: hsl(0 0 100 / 0.03); color: inherit; }
    h2 { margin-block: 0.2em 0.4em; font-size: var(--fs-xl); }
  }
  .news-meta { color: var(--clr-neutral-400); font-size: var(--fs-sm); margin: 0; }
</style>
