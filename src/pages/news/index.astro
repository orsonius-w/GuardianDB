---
import Pagesection from "../../components/sections/pagesection.astro";
import Layout from "../../layout/layout.astro";
import { newsPosts, formatDate } from "../../lib/news";
const posts = await newsPosts();
---

<Layout title="News | Guardian" description="News, updates and patch notes for Guardian.">
  <Pagesection size="md">
    <h1>News</h1>
    <p class="lede">Site and game updates. Patch notes for each client build are on the <a href="/play/#patch-notes">Play page</a>.</p>
    <div class="news-grid">
      {posts.map((post) => (
        <a href={`/news/${post.id}/`} class="news-post">
          <img src={post.data.image ?? "/images/hero.webp"} alt="" loading="lazy" decoding="async" />
          <div class="body">
            <p class="news-meta"><span class="chip">{post.data.category}</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </Pagesection>
</Layout>

<style>
  .lede { color: var(--clr-neutral-200); }
  .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); gap: 1.25rem; margin-block-start: 1.5rem; }
  .news-post {
    display: grid; grid-template-rows: auto 1fr; overflow: hidden; color: inherit; text-decoration: none;
    border: 1px solid hsl(0 0 100 / 0.12); border-radius: var(--radius-md); background: hsl(0 0 100 / 0.02);
    transition: border-color 0.15s;
    &:hover { border-color: var(--clr-primary); color: inherit; }
    img { aspect-ratio: 16 / 9; object-fit: cover; height: auto; }
    .body { padding: 1rem 1.25rem 1.25rem; }
    h2 { margin-block: 0.4em 0.3em; font-size: var(--fs-lg); }
    p { color: var(--clr-neutral-200); margin-block-end: 0; }
  }
  .news-meta { display: flex; align-items: center; gap: 0.75rem; color: var(--clr-neutral-400) !important; font-size: var(--fs-sm); }
  .chip { padding: 0.1rem 0.6rem; border-radius: var(--radius-full); background: hsl(40 100% 60% / 0.16); color: var(--clr-accent); font-weight: var(--fw-bold); font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.5px; }
</style>
