---
import { render } from "astro:content";
import Pagesection from "../../components/sections/pagesection.astro";
import Layout from "../../layout/layout.astro";
import { newsPosts, formatDate } from "../../lib/news";
import "../../styles/wiki-style.css";

export async function getStaticPaths() {
  return (await newsPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Guardian`} description={post.data.description}>
  <Pagesection size="md">
    <article class="wiki-article">
      <p class="news-meta"><a href="/news/">News</a> · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <div class="prose"><Content /></div>
    </article>
  </Pagesection>
</Layout>

<style>
  .news-meta { color: var(--clr-neutral-400); }
</style>
