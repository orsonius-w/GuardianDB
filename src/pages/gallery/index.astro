---
import Pagesection from "../../components/sections/pagesection.astro";
import Layout from "../../layout/layout.astro";
import CardGallery from "../../components/cards/CardGallery.astro";
import { cards, ELEMENTS } from "../../lib/cards";

const counts = Object.fromEntries(ELEMENTS.map((e) => [e.name, cards.filter((c) => !c.token && c.elements.includes(e.name)).length]));
---

<Layout title="Card Gallery | Guardian" description={`Browse all ${cards.filter((c) => !c.token).length} cards of the Guardian card game.`}>
  <Pagesection size="md">
    <h1>Card Gallery</h1>
    <h2>Browse by element</h2>
    <div class="column-grid element-grid">
      {ELEMENTS.map((el) => (
        <div class="grid-item">
          <a href={`/gallery/${el.slug}/`} class={`card-link badge ${el.cls}`}>
            {el.name}
            <small>{counts[el.name]} cards</small>
          </a>
        </div>
      ))}
    </div>
  </Pagesection>

  <Pagesection size="base">
    <h2>All cards</h2>
    <CardGallery cards={cards} showElementFilter />
  </Pagesection>
</Layout>

<style>
  .element-grid {
    --grid-gap: 1rem;
    --grid-max-col-count: 5;
    --grid-min-col-size: 160px;
  }
  .badge {
    display: grid;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform 0.15s;

    &:hover, &:focus-visible { transform: translateY(-2px); }
    small { font-size: var(--fs-sm); font-weight: var(--fw-regular); opacity: 0.8; }
  }
</style>
