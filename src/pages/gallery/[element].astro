---
import Pagesection from "../../components/sections/pagesection.astro";
import Layout from "../../layout/layout.astro";
import CardGallery from "../../components/cards/CardGallery.astro";
import { cards, ELEMENTS } from "../../lib/cards";

export function getStaticPaths() {
  return ELEMENTS.map((el) => ({ params: { element: el.slug }, props: { el } }));
}

const { el } = Astro.props;
const list = cards.filter((c) => c.elements.includes(el.name));
---

<Layout title={`${el.name} Cards | Guardian`} description={`All ${el.name} cards of the Guardian card game.`}>
  <Pagesection size="md">
    <p class="crumbs"><a href="/gallery/">Gallery</a> / {el.name}</p>
    <h1>{el.name} Cards</h1>
    <nav class="element-switch" aria-label="Elements">
      {ELEMENTS.map((e) => (
        <a href={`/gallery/${e.slug}/`} class={`badge ${e.cls}`} aria-current={e.slug === el.slug ? "page" : undefined}>{e.name}</a>
      ))}
    </nav>
  </Pagesection>
  <Pagesection size="base">
    <CardGallery cards={list} />
  </Pagesection>
</Layout>

<style>
  .crumbs { color: var(--clr-neutral-300); }
  .element-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;

    .badge {
      padding: 0.35rem 0.8rem;
      font-size: var(--fs-sm);
      border-radius: var(--radius-full);
      text-decoration: none;
      opacity: 0.65;
    }
    .badge[aria-current="page"], .badge:hover { opacity: 1; }
  }
</style>
