---
import Layout from "../../layout/layout.astro";
import Pagesection from "../../components/sections/pagesection.astro";
import { decks } from "../../lib/decks";
import { ELEMENTS } from "../../lib/cards";

const groups = ELEMENTS.map((e) => ({ el: e, list: decks.filter((d) => d.mainElement.name === e.name) })).filter((g) => g.list.length);
---

<Layout title="Starter Decks | Guardian" description={`The ${decks.length} pre-constructed starter decks of Guardian, with full decklists.`}>
  <Pagesection size="md">
    <h1>Starter Decks</h1>
    <p class="lede">Every pre-constructed deck that ships with the game, each built around one Guardian. Pick one in the client and play it right away, or use it as the base for your own deck.</p>
    {groups.map(({ el, list }) => (
      <section class="deck-group">
        <h2><img src={`/images/elements/${el.slug}.webp`} alt="" width="34" height="34" />{el.name}</h2>
        <div class="deck-grid">
          {list.map((d) => (
            <a href={`/decks/${d.slug}/`} class="deck-tile">
              {d.guardian?.image && <img src={d.guardian.image} alt="" width={d.guardian.imageWidth} height={d.guardian.imageHeight} loading="lazy" decoding="async" />}
              <span class="deck-name">{d.name}</span>
              <small>{d.guardian?.name}</small>
              <span class="deck-els">{d.elements.slice(0, 3).map(([e]) => <img src={`/images/elements/${e.toLowerCase()}.webp`} alt={e} width="20" height="20" />)}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </Pagesection>
</Layout>

<style>
  .lede { max-width: 46rem; color: var(--clr-neutral-200); font-size: var(--fs-md); }
  .deck-group h2 { display: flex; align-items: center; gap: 0.6rem; margin-block: 2.5rem 1rem; font-size: var(--fs-xl); }
  .deck-group h2 img { width: 2.1rem; height: 2.1rem; }
  .deck-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 1.25rem; }
  .deck-tile {
    display: grid; gap: 0.3rem; color: inherit; text-decoration: none;
    img:first-child { border-radius: 8px; height: auto; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5); transition: transform 0.15s; margin-block-end: 0.4rem; }
    &:hover img:first-child { transform: translateY(-4px); }
    &:hover { color: inherit; }
  }
  .deck-name { font-family: var(--ff-secondary); font-size: var(--fs-md); font-weight: var(--fw-bold); }
  small { color: var(--clr-neutral-300); }
  .deck-els { display: flex; gap: 0.25rem; }
  .deck-els img { width: 1.25rem; height: 1.25rem; }
</style>
