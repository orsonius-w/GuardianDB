---
import Layout from "../layout/layout.astro";
import Embers from "../components/home/Embers.astro";
import TiltCards from "../components/home/TiltCards.astro";
import { cards, ELEMENTS } from "../lib/cards";
import { decks } from "../lib/decks";
import { newsPosts, formatDate } from "../lib/news";
import client from "../data/client.json";
import { SITE_LINKS } from "../data/site";
import { parseTextToHTML } from "../js/parseTextToHtml";

const pub = cards.filter((c) => !c.token);
const total = pub.length;
const guardianCount = pub.filter((c) => c.type === "Guardian").length;
const latest = (await newsPosts()).slice(0, 3);
const note = client.notes?.[0];
const firstLine = (note?.body ?? "").split("\n").find((l) => l.trim().startsWith("-"))?.replace(/^-\s*/, "").replace(/\*\*/g, "") ?? "";
const ticker = firstLine.length > 110 ? firstLine.slice(0, 107).replace(/\s+\S*$/, "") + "…" : firstLine;

// Three fanned cards in the hero: strong rare Summons with art, varied by build.
const rares = pub.filter((c) => c.image && c.type === "Summon" && c.rarity === "Special Rare");
const pick = (arr: any[], n: number, seed: number) => Array.from({ length: n }, (_, i) => arr[(seed * 7 + Math.floor(((i + 0.5) * arr.length) / n)) % arr.length]).filter(Boolean);
const fan = pick(rares, 3, client.build);

// Element tiles: each element's Guardian art (the first starter deck's Guardian of that element).
const deckGuardians = decks.filter((d) => d.guardian?.image);
const tiles = ELEMENTS.filter((e) => e.name !== "Neutral").map((e) => {
  const d = deckGuardians.find((x) => x.guardian!.elements[0] === e.name);
  const g = d?.guardian ?? pub.find((c) => c.type === "Guardian" && c.image && c.elements[0] === e.name);
  const count = pub.filter((c) => c.elements.includes(e.name)).length;
  return { ...e, guardian: g, count };
});

// Guardian spotlight: rotates with each client build.
const spot = deckGuardians[client.build % deckGuardians.length];
const spotAbilities = (spot?.guardian?.text ?? "").split("\n").filter(Boolean).map((l) => {
  const m = l.match(/^([^:]{2,30}):\s*(.*)$/);
  return m ? { label: m[1], text: m[2] } : { label: "", text: l };
});

const modes = [
  { name: "Online match", text: "Challenge a friend one on one over the internet: one of you hosts, the other joins." },
  { name: "Versus computer", text: "Practise against an AI opponent that plays every card. Play a single game or a best of three with your sideboard." },
  { name: "Story campaign", text: "Hand-built battles with story scenes in between, played across a world map. New chapters are being written." },
  { name: "Draft", text: "Pick your deck card by card from element groups, then fight drafted opponents until six wins or three losses." },
  { name: "Tournament", text: "Sixteen decks, Swiss rounds or a knockout bracket. Enter with your own deck, or sit back and watch the computer play it out." },
  { name: "Hot-seat", text: "Two players, one screen. Pass the mouse at the end of each turn, one game or best of three." },
];
const features = [
  { name: "On the battlefield", img: "/images/client/gameplay.webp", text: "Every match is fought on a 28-field grid. Your Summons march, flank and hold the line while your hand, Energy and Treasure Chest sit beside the board." },
  { name: "Deck builder", img: "/images/client/deck-builder.webp", text: "Search and filter the whole card pool by element, cost, type and keyword, and build with every card unlocked." },
  { name: "Story campaign", img: "/images/client/2-story.webp", text: "Meet the people of the world between battles, with full-art story scenes." },
  { name: "World map", img: "/images/client/1-campaign-map.webp", text: "Travel from region to region as the campaign unfolds." },
  { name: "Claim the win", img: "/images/client/victory.webp", text: "Bring the enemy Guardian down, then go again: rematch, new match or back to the menu." },
]
const soon = [
  { name: "Dungeon", text: "a rogue-like run: carry your Guardian and deck from fight to fight and earn upgrades along the way." },
  { name: "Challenges", text: "puzzle boards with a set position, a goal and a turn limit." },
  { name: "AI difficulty", text: "an easier and a tougher computer opponent." },
];
const heroes = [1, 2, 3, 4].map((i) => `/images/hero/hero-${i}.webp`);
---

<Layout title="Guardian — the tactical card game">
  <section class="hero">
    <div class="hero-art" aria-hidden="true">
      {heroes.map((src, i) => <img src={src} alt="" class:list={["slide", { on: i === 0 }]} fetchpriority={i === 0 ? "high" : "low"} loading={i === 0 ? "eager" : "lazy"} decoding="async" />)}
    </div>
    <div class="hero-shade"></div>
    <Embers />
    <div class="base-layout"><div class="hero-content">
      <div class="hero-copy">
        <a href="/play/#patch-notes" class="version-badge"><span class="pulse"></span>{client.version} · playable now</a>
        <h1><img src="/images/brand/logo.webp" alt="Guardian" width="900" height="180" class="hero-logo" /></h1>
        <p class="hero-tag">Tactical grid combat meets collectible cards. Command a Guardian, summon an army and win the battle on the board as much as in your hand.</p>
        <div class="hero-actions">
          <a href={SITE_LINKS.itch} class="btn-game primary" target="_blank" rel="noopener">
            <span>Play free on itch.io</span>
          </a>
          <a href="/learn/" class="btn-game">Learn to play</a>
        </div>
      </div>
      <div class="fan" aria-label="Featured cards">
        {fan.map((c, i) => (
          <a href={`/cards/${c.slug}/`} class={`fan-card f${i}`} title={c.name}>
            <div class="tilt"><img src={c.image} alt={c.name} width={c.imageWidth} height={c.imageHeight} decoding="async" /></div>
          </a>
        ))}
      </div>
    </div></div>
    <div class="hero-dots" role="group" aria-label="Background art">
      {heroes.map((_, i) => <button type="button" aria-label={`Show artwork ${i + 1}`} class:list={{ on: i === 0 }} data-i={i}></button>)}
    </div>
  </section>

  {ticker && (
    <a href="/play/#patch-notes" class="ticker">
      <span class="ticker-tag">Build {client.build}</span>
      <span class="ticker-text">{ticker}</span>
      <span class="ticker-more">Patch notes →</span>
    </a>
  )}

  <nav class="jump" aria-label="On this page">
    <div class="jump-inner">
      <a href="#what">What is Guardian?</a>
      <a href="#how">How it works</a>
      <a href="#elements">Elements</a>
      <a href="#modes">Game modes</a>
      <a href="#features">Features</a>
      <a href="#play" class="jump-play">Play free</a>
    </div>
  </nav>

  <section class="band base-layout" id="what">
    <div class="what">
      <header class="band-head">
        <span class="kicker">What is Guardian?</span>
        <h2>A card game played on a battlefield</h2>
        <p>Guardian is a collectible card game with the board of a tactics RPG. Your cards are an army: they walk, flank, hold ground and strike from range, so where you put a card matters as much as what it does. In development since 2010, as a paper game first and now as a digital client.</p>
      </header>
      <div class="counters">
        <div><strong data-count={total}>{total}</strong><span>cards</span></div>
        <div><strong data-count={guardianCount}>{guardianCount}</strong><span>Guardians</span></div>
        <div><strong data-count="9">9</strong><span>elements</span></div>
        <div><strong data-count={decks.length}>{decks.length}</strong><span>starter decks</span></div>
      </div>
    </div>
    <div class="pillars">
      <div class="pillar">
        <span class="pillar-n">I</span>
        <h3>Position is power</h3>
        <p>Summons enter beside your Guardian and fight their way across a 28-field grid. Flanks, fast lanes and zones decide as much as the cards you draw.</p>
        <a href="/wiki/board/">The board →</a>
      </div>
      <div class="pillar">
        <span class="pillar-n">II</span>
        <h3>Strike first</h3>
        <p>The attacker hits first, and only a survivor strikes back. Who attacks, from where and in which order is the game.</p>
        <a href="/wiki/combat/">Combat →</a>
      </div>
      <div class="pillar">
        <span class="pillar-n">III</span>
        <h3>Your Treasure Chest</h3>
        <p>Five powerful cards set aside before the game. Buy into them as the battle unfolds, at the price of a smaller Energy store.</p>
        <a href="/wiki/treasure-chest/">Treasures →</a>
      </div>
    </div>
    <aside class="newbie">
      <div>
        <h3>New to Guardian?</h3>
        <p>The four-step guide walks you through the board, a turn and your first attack. No rulebook needed.</p>
      </div>
      <div class="newbie-actions">
        <a href="/learn/" class="btn-game primary">Start the guide</a>
        {SITE_LINKS.discord && <a href={SITE_LINKS.discord} class="btn-game" target="_blank" rel="noopener">Ask on Discord</a>}
      </div>
    </aside>
  </section>

  <section class="band base-layout" id="how">
    <header class="band-head">
      <span class="kicker">How does it work?</span>
      <h2>Three steps to a match</h2>
    </header>
    <ol class="steps">
      <li>
        <span class="step-n">1</span>
        <h3>Pick a Guardian</h3>
        <p>Your Guardian is your commander and your life total: 15 Life. Pick one of {decks.length} starter decks or build your own around it, with five Treasures in your chest.</p>
        <a href="/decks/">Starter decks →</a>
      </li>
      <li>
        <span class="step-n">2</span>
        <h3>Take the field</h3>
        <p>Workers make Energy, Energy pays for cards. Summon units, march them forward, cast Spells and set Traps where your opponent will step.</p>
        <a href="/wiki/turn-structure/">A turn →</a>
      </li>
      <li>
        <span class="step-n">3</span>
        <h3>Bring the Guardian down</h3>
        <p>Break through and reduce the enemy Guardian to 0 Life, or outlast them until they have to draw from an empty deck.</p>
        <a href="/wiki/combat/">Combat →</a>
      </li>
    </ol>
  </section>

  <section class="band base-layout" id="elements">
    <header class="band-head">
      <span class="kicker">Nine elements</span>
      <h2>Choose your element</h2>
      <p>Each element has its own Guardians, creatures and way to win. Mix two, or go all in on one.</p>
    </header>
    <div class="tiles">
      {tiles.map((t) => (
        <a href={`/gallery/${t.slug}/`} class={`tile el-${t.slug}`}>
          {t.guardian?.image ? <img src={t.guardian.image} alt="" loading="lazy" decoding="async" /> : <div class="tile-empty"></div>}
          <span class="tile-icon"><img src={`/images/elements/${t.slug}.webp`} alt="" width="40" height="40" loading="lazy" /></span>
          <span class="tile-name">{t.name}</span>
          <span class="tile-count">{t.count ? `${t.count} cards` : "coming soon"}</span>
        </a>
      ))}
    </div>
  </section>

  {spot?.guardian && (
    <section class="band base-layout"><div class="spotlight">
      <div class="spot-card"><div class="tilt"><img src={spot.guardian.image} alt={spot.guardian.name} width={spot.guardian.imageWidth} height={spot.guardian.imageHeight} loading="lazy" /></div></div>
      <div class="spot-copy">
        <span class="kicker">Guardian spotlight</span>
        <h2>{spot.guardian.name}</h2>
        <p class="spot-meta"><span class={`badge ${spot.mainElement.cls}`}>{spot.mainElement.name}</span> {spot.guardian.life} Life</p>
        <dl class="spot-abilities">
          {spotAbilities.map((a) => (<div>{a.label && <dt>{a.label}</dt>}<dd set:html={parseTextToHTML(a.text)} /></div>))}
        </dl>
        <div class="hero-actions">
          <a href={`/decks/${spot.slug}/`} class="btn-game primary">Deck: {spot.name}</a>
          <a href={`/cards/${spot.guardian.slug}/`} class="btn-game">Card details</a>
        </div>
      </div>
    </div></section>
  )}

  <section class="band base-layout" id="modes">
    <header class="band-head">
      <span class="kicker">Game modes</span>
      <h2>Ways to play</h2>
      <p>Everything below is in the current alpha.</p>
    </header>
    <div class="modes">
      {modes.map((m) => (
        <div class="mode">
          <h3>{m.name}</h3>
          <p>{m.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="band base-layout" id="features">
    <header class="band-head">
      <span class="kicker">Features</span>
      <h2>What's in the client</h2>
    </header>
    <div class="features">
      {features.map((f) => (
        <figure class="feature">
          <div class="feature-img"><img src={f.img} alt="" width="1600" height="900" loading="lazy" decoding="async" /></div>
          <figcaption><h3>{f.name}</h3><p>{f.text}</p></figcaption>
        </figure>
      ))}
    </div>
    <div class="soon">
      <h3>Coming soon</h3>
      <ul>
        {soon.map((x) => <li><strong>{x.name}</strong> <span>{x.text}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="cta" id="play">
    <img src="/images/client/gameplay.webp" alt="" class="cta-bg" decoding="async" />
    <div class="base-layout"><div class="cta-inner">
      <div class="laptop">
        <img src="/images/client/gameplay-action.webp" alt="A match in the Guardian client: a Summon attacks" class="laptop-screen" width="1600" height="900" decoding="async" />
        <img src="/images/laptop.png" alt="" class="laptop-frame" width="1200" height="692" decoding="async" />
      </div>
      <div class="cta-copy">
        <h2>Play Guardian on your PC</h2>
        <p>The alpha is free on itch.io for Windows. Play the campaign, draft, take on the computer or challenge a friend online. Every card is unlocked.</p>
        <a href={SITE_LINKS.itch} class="btn-cta" target="_blank" rel="noopener">
          <span class="btn-cta-label">Download the alpha</span>
          <small>{client.version}</small>
        </a>
        {SITE_LINKS.discord && (
          <p class="cta-discord">Find opponents, share decks and follow development on <a href={SITE_LINKS.discord} target="_blank" rel="noopener">our Discord</a>.</p>
        )}
      </div>
    </div></div>
  </section>

  {latest.length > 0 && (
    <section class="band base-layout">
      <header class="band-head news-head">
        <h2>Latest news</h2>
        <a href="/news/">All news →</a>
      </header>
      <div class="news">
        {latest.map((p) => (
          <a href={`/news/${p.id}/`} class="news-card">
            <div class="news-img"><img src={p.data.image ?? "/images/hero/hero-1.webp"} alt="" loading="lazy" decoding="async" /><span class="news-tag">{p.data.category}</span></div>
            <div class="news-body">
              <small>{formatDate(p.data.date)}</small>
              <strong>{p.data.title}</strong>
              <span>{p.data.description}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
  <TiltCards />
</Layout>

<script>
  // Hero art crossfade
  const slides = [...document.querySelectorAll<HTMLImageElement>(".hero .slide")];
  const dots = [...document.querySelectorAll<HTMLButtonElement>(".hero-dots button")];
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let cur = 0, timer: number | undefined;
  const show = (i: number) => {
    slides[cur].classList.remove("on"); dots[cur].classList.remove("on");
    cur = (i + slides.length) % slides.length;
    slides[cur].classList.add("on"); dots[cur].classList.add("on");
  };
  const start = () => { if (!reduce) timer = window.setInterval(() => show(cur + 1), 7000); };
  dots.forEach((d) => d.addEventListener("click", () => { clearInterval(timer); show(+d.dataset.i!); start(); }));
  start();

  // Count-up numbers when the counters scroll into view
  const nums = document.querySelectorAll<HTMLElement>("[data-count]");
  if (!reduce) {
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement, to = +el.dataset.count!, t0 = performance.now();
      const step = (t: number) => { const k = Math.min(1, (t - t0) / 1100); el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step); io.unobserve(el);
    }), { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    min-height: min(92dvh, 52rem);
    display: grid;
    align-items: center;
    padding-block: 7rem 5rem;
    margin-block-start: -1rem;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-art { position: absolute; inset: 0; z-index: -2; background: #0b0d10; }
  .slide {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%;
    opacity: 0; transition: opacity 1.6s ease;
    will-change: transform, opacity; backface-visibility: hidden; transform: translate3d(0, 0, 0) scale(1.02);
  }
  .slide.on { opacity: 1; animation: hero-zoom 12s linear forwards; }
  @keyframes hero-zoom { from { transform: translate3d(0, 0, 0) scale(1.02); } to { transform: translate3d(0, 0, 0) scale(1.1); } }
  .hero-shade {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse at 25% 55%, hsl(210 30% 6% / 0.55), transparent 60%),
      linear-gradient(90deg, hsl(210 20% 5% / 0.85), hsl(210 20% 5% / 0.25) 55%, transparent),
      linear-gradient(transparent 55%, var(--clr-neutral-900));
  }
  .hero-content { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 3rem; align-items: center; }
  .hero-copy { max-width: 36rem; }
  .hero h1 { margin: 0.5rem 0 1rem; line-height: 0; }
  .hero-logo { width: min(100%, 30rem); height: auto; filter: drop-shadow(0 4px 18px rgb(0 0 0 / 0.7)) drop-shadow(0 0 30px hsl(40 100% 60% / 0.15)); }
  .hero-tag { font-size: var(--fs-md); line-height: 1.55; color: var(--clr-neutral-100); text-shadow: 0 1px 8px rgb(0 0 0 / 0.8); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-block-start: 1.75rem; }

  .version-badge {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.3rem 0.85rem; border-radius: 999px;
    font-size: var(--fs-sm); font-weight: 600; letter-spacing: 0.03em; color: var(--clr-neutral-50); text-decoration: none;
    background: hsl(210 20% 8% / 0.7); border: 1px solid hsl(40 100% 60% / 0.45); backdrop-filter: blur(4px);
    &:hover { border-color: var(--clr-accent); }
  }
  .pulse { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: hsl(130 70% 55%); box-shadow: 0 0 0 0 hsl(130 70% 55% / 0.7); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 0.5rem hsl(130 70% 55% / 0); } 100% { box-shadow: 0 0 0 0 hsl(130 70% 55% / 0); } }

  /* game-style buttons (global so other bands can reuse them on this page) */
  :global(.btn-game) {
    --edge: hsl(40 60% 55% / 0.7);
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    padding: 0.75rem 1.6rem; min-height: 2.9rem;
    font-family: var(--ff-brand); font-weight: 700; font-size: var(--fs-base); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--clr-neutral-50); text-decoration: none;
    background: linear-gradient(hsl(210 15% 18% / 0.85), hsl(210 15% 10% / 0.9));
    border: 1px solid var(--edge);
    clip-path: polygon(10px 0, calc(100% - 10px) 0, 100% 50%, calc(100% - 10px) 100%, 10px 100%, 0 50%);
    transition: filter 0.15s, transform 0.15s;
  }
  :global(.btn-game:hover) { filter: brightness(1.25); transform: translateY(-1px); color: white; }
  :global(.btn-game.primary) {
    color: hsl(30 60% 10%);
    background: linear-gradient(hsl(44 100% 72%), hsl(36 90% 52%) 55%, hsl(30 85% 40%));
    border-color: hsl(45 100% 80%);
    text-shadow: 0 1px 0 hsl(45 100% 85% / 0.6);
  }
  :global(.btn-game.primary:hover) { color: hsl(30 60% 8%); }

  .fan { position: relative; width: 25rem; height: 25rem; }
  .fan-card { position: absolute; top: 2rem; left: 50%; width: 11.5rem; transform-origin: 50% 120%; transition: transform 0.35s ease; }
  .fan-card img { display: block; width: 100%; height: auto; border-radius: 8px; box-shadow: 0 14px 40px rgb(0 0 0 / 0.65); }
  .f0 { transform: translateX(-50%) translateX(-6.5rem) rotate(-14deg); }
  .f1 { transform: translateX(-50%) translateY(-1rem); z-index: 2; }
  .f2 { transform: translateX(-50%) translateX(6.5rem) rotate(14deg); }
  .fan:hover .f0 { transform: translateX(-50%) translateX(-8rem) rotate(-18deg); }
  .fan:hover .f2 { transform: translateX(-50%) translateX(8rem) rotate(18deg); }
  .fan-card:hover { z-index: 3; }

  .hero-dots { position: absolute; bottom: 1.75rem; left: 50%; transform: translateX(-50%); z-index: 3; display: flex; gap: 0.5rem; }
  .hero-dots button { width: 2rem; height: 0.3rem; padding: 0; border: 0; border-radius: 2px; background: hsl(0 0 100 / 0.3); cursor: pointer; transition: background 0.3s; }
  .hero-dots button.on { background: var(--clr-accent); }

  /* ---------- ticker ---------- */
  .ticker {
    display: flex; align-items: center; gap: 1rem; padding: 0.7rem max(1rem, calc((100vw - 75rem) / 2));
    background: linear-gradient(90deg, hsl(40 60% 20% / 0.35), hsl(210 15% 12%) 40%);
    border-block: 1px solid hsl(40 60% 50% / 0.25);
    color: var(--clr-neutral-100); text-decoration: none; font-size: var(--fs-sm);
    &:hover .ticker-more { color: var(--clr-accent); }
  }
  .ticker-tag { flex: none; font-family: var(--ff-brand); font-weight: 700; color: var(--clr-accent); letter-spacing: 0.05em; text-transform: uppercase; }
  .ticker-text { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ticker-more { flex: none; color: var(--clr-neutral-300); }

  /* ---------- counters ---------- */
  .counters { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center; }
  .counters div { display: grid; gap: 0.1rem; }
  .counters strong { font-family: var(--ff-brand); font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1; background: linear-gradient(hsl(45 100% 80%), hsl(35 85% 50%)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .counters span { color: var(--clr-neutral-300); text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--fs-sm); }

  /* ---------- bands ---------- */
  .band { padding-block: 4rem; }
  .band-head { margin-block-end: 2rem; max-width: 40rem; }
  .band-head h2, .spot-copy h2 { font-family: var(--ff-brand); font-size: var(--fs-2xl); letter-spacing: 0.02em; margin-block-end: 0.35rem; }
  .band-head p { color: var(--clr-neutral-200); }
  .kicker { font-family: var(--ff-brand); color: var(--clr-accent); text-transform: uppercase; letter-spacing: 0.15em; font-size: var(--fs-sm); font-weight: 700; }

